# Secrets — Turso URL/token live in .env, never in the repo
.env
.env.*

# Live database (and WAL/SHM sidecars) — real trade data, never committed
*.db
*.db-shm
*.db-wal
*.db.bak
backups/
# Replicas set aside by sync repair/reconcile (workspace-synced.db.conflict-<stamp>
# plus -wal/-shm/-info). Full copies of trade data; their names do not end in
# .db, so the rules above miss them.
*.conflict-*
*.db.*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / frontend
node_modules/
dist/

# Tauri / Rust
src-tauri/target/
src-tauri/binaries/

# PyInstaller
build/

# Editor noise
.DS_Store
Thumbs.db
*.db-info
